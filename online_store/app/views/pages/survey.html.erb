<h1>Опитування покупців</h1>

<%= form_with url: survey_submit_path, method: :post, local: true do |form| %>
  <p>
    <%= form.label :name, "Ваше ім'я" %><br>
    <%= form.text_field :name, required: true %>
  </p>

  <p>
    <%= form.label :email, "Електронна пошта" %><br>
    <%= form.email_field :email, required: true %>
  </p>

  <p>
    <%= form.label :feedback, "Ваш відгук" %><br>
    <%= form.text_area :feedback, required: true %>
  </p>

  <%= form.submit "Надіслати" %>
<% end %>